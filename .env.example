# ==============================================================================
# Database Configuration (Microsoft SQL Server)
# ==============================================================================

# System Administrator (SA) password
# MSSQL requires >= 8 chars, including uppercase, lowercase, numbers, and symbols
MSSQL_SA_PASSWORD=YourStrongPasswordHere

# Database connection parameters
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_NAME=MarketAnalytics
ACCEPT_EULA=Y

# Optional: ODBC driver name (driver strings can differ across OS distributions)
DB_DRIVER=ODBC Driver 18 for SQL Server

# Optional: Application settings
STREAMLIT_PORT=8501
